# ────────────────────────────────────────────────────────────────
# Kök .htaccess — tüm istekleri public/ klasörüne yönlendirir.
# ────────────────────────────────────────────────────────────────

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Sonsuz loop engeli: zaten public/ ile başlıyorsa dokunma
    RewriteCond %{REQUEST_URI} !^/public/

    # public/ altında gerçek dosya/dizin varsa oraya gönder
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Dosya/dizin değilse, public/index.php'ye gönder (front controller)
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/index.php?url=$1 [QSA,L]
</IfModule>

# Hassas dosyalara erişimi engelle
<FilesMatch "\.(env|log|sql|bak|htpasswd|gitignore|md)$">
    Require all denied
</FilesMatch>

Options -Indexes
