# ────────────────────────────────────────────────────────────────
# Kök .htaccess — tüm istekleri public/ klasörüne yönlendirir.
# Hostinger document root'u public_html olduğu için, bu dosya
# kullanıcıyı görünmez şekilde public/ alt klasörüne yönlendirir.
# ────────────────────────────────────────────────────────────────

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Eğer istek public/ ile başlamıyorsa, public/ ekle (görünmez)
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Hassas dosyalara erişimi tamamen engelle
<FilesMatch "\.(env|log|sql|bak|htpasswd|gitignore|md)$">
    Require all denied
</FilesMatch>

# Dizin listelemeyi kapat
Options -Indexes
