# ── Uygulama ──────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_URL=https://www.dogukankopuk.com

# ── Veritabanı ────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# ── Oturum ────────────────────────────────────────────────────
SESSION_LIFETIME=7200
SESSION_SECURE=true

# ── SMTP ──────────────────────────────────────────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# ── İletişim / NAP ────────────────────────────────────────────
CONTACT_PHONE=
CONTACT_PHONE_HREF=
CONTACT_WHATSAPP=
CONTACT_EMAIL=

# ── Adres ─────────────────────────────────────────────────────
ADDRESS_STREET=
ADDRESS_DISTRICT=
ADDRESS_CITY=
ADDRESS_COUNTRY=TR
ADDRESS_POSTAL=
GEO_LATITUDE=
GEO_LONGITUDE=

# ── Analytics ─────────────────────────────────────────────────
GA4_ID=
AW_ID=

# ── Sosyal Medya ──────────────────────────────────────────────
SOCIAL_INSTAGRAM=
SOCIAL_FACEBOOK=
SOCIAL_LINKEDIN=
SOCIAL_YOUTUBE=

# ── Google Business Profile ───────────────────────────────────
GBP_PLACE_ID=
GBP_PROFILE_URL=
GBP_REVIEW_URL=

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_CONTACT=5
RATE_LIMIT_APPOINTMENT=3
RATE_LIMIT_LOGIN=5
RATE_LIMIT_WINDOW=900

# ── TinyMCE ───────────────────────────────────────────────────
TINYMCE_MODE=cloud
TINYMCE_API_KEY=
