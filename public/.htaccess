Options -Indexes

# ── install.php Production Güvenliği ──────────────────────────
<Files "install.php">
    Require all denied
</Files>


# ── Hassas Dosyalar ────────────────────────────────────────────
<FilesMatch "\.(env|log|sql|bak|htpasswd)$">
    Require all denied
</FilesMatch>

# ── Klasör Erişim Engeli ───────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|config|routes|storage|templates)/.*$ - [F,L]
</IfModule>

# ── URL Rewrite ────────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── RewriteBase ──────────────────────────────────────────
    # XAMPP yerel kurulum için:  /psikolog/public/
    # Production kök domain için: /
    # .env dosyasında APP_URL tanımlıysa bu değer override edilir.
    RewriteBase /

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>

# ── Güvenlik Başlıkları ────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # SW dosyası cache'lenmesin
    <Files "sw.js">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </Files>
</IfModule>

# ── Sıkıştırma ─────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>
