Options -Indexes

# ── install.php Production Güvenliği ──────────────────────────
<Files "install.php">
    Require all denied
</Files>

# ── Hassas Dosyalar ────────────────────────────────────────────
<FilesMatch "\.(env|log|sql|bak|htpasswd)$">
    Require all denied
</FilesMatch>

# ── Güvenlik Başlıkları ────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    <Files "sw.js">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </Files>
</IfModule>

# ── Sıkıştırma ─────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>

# Not: URL rewrite işi kök .htaccess'te yapılıyor.
# Buradaki RewriteBase mantığı çakışma yaratmaması için kaldırıldı.
